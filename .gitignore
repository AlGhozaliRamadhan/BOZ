# Dependencies
node_modules/
.pnpm-store/

# Build output
/dist/
/.next/
/out/
/build/
*.tsbuildinfo

# Generated Tauri host, bundled Node sidecar, and standalone Next.js resources.
# Keep only the tracked directory marker and its packaging guidance.
/src-tauri/target/
/src-tauri/gen/
/src-tauri/resources/*
!/src-tauri/resources/.gitkeep
!/src-tauri/resources/README.md
src-tauri/icons/android/
src-tauri/icons/ios/
src-tauri/icons/icon.icns
src-tauri/icons/64x64.png
src-tauri/icons/Square*.png
src-tauri/icons/StoreLogo.png

# Environment variables and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.cert

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Runtime files
*.pid
*.seed
*.pid.lock

# Test and coverage
coverage/
.nyc_output/
.vitest/

# IDE and editor
.vscode/
.idea/
*.swp
*.swo
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# OS and temporary files
.DS_Store
Thumbs.db
/data/
temp/
tmp/
.temp/
.tmp/

# Playwright MCP snapshots
.playwright-mcp/

# Runtime data caches
src/data/

# Generated desktop smoke profiles and release staging. Final release archives
# belong only under artifacts/releases/v<VERSION>/ and are never committed.
/artifacts/desktop-smoke/
/artifacts/staged/
/artifacts/release/
/artifacts/releases/

# Local Developer Caches
.eslintcache
*.log

# Local agent configs
AGENTS.md
CLAUDE.md
.agents/
.claude/
.worktrees/
docs/improvements.md
