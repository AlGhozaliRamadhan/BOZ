  "compilerOptions": {
    "noEmit": false,
    "incremental": false,
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": [
    "src/main.ts",
    "src/cli/dev-web.ts",
    "src/cli/background-launcher.ts",
