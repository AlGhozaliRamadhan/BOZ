{
  "name": "@agr77/boz",
  "version": "2.4.2",
  "description": "Web-first AI market intelligence dashboard for technical, macro, news, sentiment, and risk-aware analysis.",
  "main": "dist/main.js",
  "bin": {
    "boz": "./dist/main.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/",
    ".next/standalone/",
    ".next/static/",
    "public/",
    "scripts/copy-static.js",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "postinstall": "node scripts/copy-static.js",
    "dev": "cross-env BOZ_DEV=1 tsx src/main.ts",
    "dev:web": "next dev --webpack",
    "build": "npm run build:web",
    "build:web": "next build --webpack",
    "build:launcher": "node scripts/clean-dist.js && tsc -p tsconfig.launcher.json && node scripts/build-env.js",
    "build:package": "npm run build:launcher && npm run build:web && node scripts/copy-static.js",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build:package",
    "prepublishOnly": "npm test && npm run typecheck",
    "test:install": "npm install -g . && boz --version && boz --help",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage --exclude tests/cli/*-web.test.ts"
  },
  "keywords": [
    "ai",
    "market-analysis",
    "web-dashboard",
    "stocks",
    "idx",
    "crypto",
    "trading",
    "technical-indicators",
    "sentiment",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/AlGhozaliRamadhan/boz.git"
  },
  "bugs": {
    "url": "https://github.com/AlGhozaliRamadhan/boz/issues"
  },
  "homepage": "https://github.com/AlGhozaliRamadhan/boz#readme",
  "author": "AGR",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "ajv": "^8.17.1",
    "axios": "^1.18.1",
    "dotenv": "^17.4.2",
    "isomorphic-dompurify": "^3.23.0",
    "marked": "^18.0.5",
    "openai": "^7.5.0",
    "rss-parser": "^3.13.0",
    "technicalindicators": "^3.1.0",
    "yahoo-finance2": "^4.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "19.2.17",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^10.1.0",
    "next": "^16.3.0",
    "postcss": "^8.5.23",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "postcss": "^8.5.23"
  }
}
