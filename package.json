{
  "name": "boz",
  "version": "2.2.0",
  "description": "Open-source AI market analyzer that combines real-time data, technical indicators, macro context, news, and sentiment into structured insights.",
  "main": "dist/main.js",
  "bin": {
    "boz": "./dist/main.js"
  },
  "files": [
    "dist/",
    ".next/standalone/",
    ".next/static/",
    "public/",
    "scripts/",
    ".env.build",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "postinstall": "node scripts/copy-static.js",
    "dev": "cross-env BOZ_DEV=1 tsx src/main.ts",
    "dev:web": "next dev --webpack",
    "build": "next build --webpack",
    "build:web": "next build --webpack",
    "start": "next start",
    "lint": "next lint",
    "dev:cli": "tsx src/main.ts",
    "ping": "node dist/utils/ping.js",
    "build:cli": "tsc -p tsconfig.cli.json && node scripts/build-env.js",
    "start:cli": "node dist/main.js",
    "prepublishOnly": "npm run build:cli && npm run build:web",
    "test:install": "npm install -g . && boz --version && boz --help",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "keywords": [
    "ai",
    "market-analysis",
    "stocks",
    "trading",
    "technical-indicators",
    "sentiment",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/AlGhozaliRamadhan/boz.git"
  },
  "bugs": {
    "url": "https://github.com/AlGhozaliRamadhan/boz/issues"
  },
  "homepage": "https://github.com/AlGhozaliRamadhan/boz#readme",
  "author": "AGR",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "ajv": "^8.17.1",
    "axios": "^1.18.1",
    "dotenv": "^17.4.2",
    "isomorphic-dompurify": "^3.21.0",
    "marked": "^18.0.5",
    "marked-terminal": "^7.3.0",
    "openai": "^6.46.0",
    "rss-parser": "^3.13.0",
    "technicalindicators": "^3.1.0",
    "yahoo-finance2": "^3.15.4"
  },
  "devDependencies": {
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^26.1.1",
    "@types/react": "19.2.17",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^10.1.0",
    "next": "^16.2.10",
    "postcss": "^8.5.15",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "postcss": "^8.5.15",
    "marked-terminal": {
      "marked": "$marked"
    }
  }
}
