{
  "name": "boz",
  "version": "1.5.2",
  "description": "Open-source AI market analyzer that combines real-time data, technical indicators, macro context, news, and sentiment into structured insights.",
  "main": "dist/main.js",
  "bin": {
    "boz": "./dist/main.js"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "ping": "tsx src/utils/ping.ts",
    "build": "tsc && node scripts/install-global.js",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "keywords": [
    "ai",
    "market-analysis",
    "stocks",
    "trading",
    "technical-indicators",
    "sentiment",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/AlGhozaliRamadhan/boz.git"
  },
  "bugs": {
    "url": "https://github.com/AlGhozaliRamadhan/boz/issues"
  },
  "homepage": "https://github.com/AlGhozaliRamadhan/boz#readme",
  "author": "AGR",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "axios": "^1.16.0",
    "dotenv": "^17.4.2",
    "openai": "^6.35.0",
    "rss-parser": "^3.13.0",
    "technicalindicators": "^3.1.0",
    "typescript": "^6.0.3",
    "yahoo-finance2": "^3.14.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.5",
    "tsx": "^4.21.0",
    "vitest": "^4.1.5"
  }
}
