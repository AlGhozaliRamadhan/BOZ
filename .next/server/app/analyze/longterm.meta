{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/analyze/layout,_N_T_/analyze/longterm/layout,_N_T_/analyze/longterm/page,_N_T_/analyze/longterm"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/analyze/longterm/__PAGE__",
    "/analyze/longterm",
    "/analyze",
    "/_index",
    "/_head"
  ]
}