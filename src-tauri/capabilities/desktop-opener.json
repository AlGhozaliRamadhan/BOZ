{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-opener",
  "description": "Allow the fixed BOZ dashboard origin to open ordinary web links in the system browser.",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:21526/*"]
  },
  "permissions": [
    "opener:allow-open-url",
    "opener:allow-default-urls"
  ]
}
